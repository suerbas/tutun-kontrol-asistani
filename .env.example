# Rol oyunu için OpenRouter ayarları. Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun.
# .env.local git'e gönderilmez. Anahtarı tarayıcı koduna veya repoya koymayın.
OPENROUTER_API_KEY=
# OpenRouter model sayfasındaki model kimliği (ör. google/...:free). Ücretsiz modeller istek sınırlıdır.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# İsteğe bağlı; varsayılan https://openrouter.ai/api/v1
# OPENROUTER_BASE_URL=
