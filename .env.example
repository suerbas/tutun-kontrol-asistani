# Rol oyunu ve görüşme asistanı için OpenRouter ayarları. Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun.
# .env.local git'e gönderilmez. Anahtarı tarayıcı koduna veya repoya koymayın.
OPENROUTER_API_KEY=
# OpenRouter model kimliği. 20 vakalık testte (npm run eval:assistant) en iyi sonucu Haiku verdi.
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# İsteğe bağlı; varsayılan https://openrouter.ai/api/v1
# OPENROUTER_BASE_URL=
# "deny": istekler yalnızca istemleri saklamayan ve eğitimde kullanmayan sağlayıcılara gider.
# Ücretsiz modellerin çoğu bu koşulu sağlamaz (404); o durumda bu satırı kaldırın.
OPENROUTER_DATA_COLLECTION=deny
# "off": modelin cevap öncesi "düşünmesini" kapatır. Düşünme token'ları cevabı yarıda bırakabiliyor;
# kapalıyken cevaplar daha hızlı ve ucuz.
OPENROUTER_REASONING=off
